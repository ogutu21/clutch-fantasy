rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The organiser is anyone with a document in the "admins" collection (you create it by hand).
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // A player can read only their own admin document (so the admin page can check).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Shared picture library: everyone can see the pictures, only the organiser adds or removes them.
    match /avatarLibrary/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["name", "data", "createdAt"])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 150000;
      allow delete: if isAdmin();
    }

    // Each tournament: its name, status, players, stages and match stats.
    // Anyone can read them, only the organiser can create or change them.
    match /tournaments/{tid} {
      allow read: if true;
      allow write: if isAdmin();

      // Private squads. Only you (and the organiser, to work out scores) can read them.
      // Nobody can change a squad once the organiser has ended the tournament.
      match /squads/{uid} {
        allow delete: if isAdmin();   // the organiser can clear a tournament's squads (Delete tournament)
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid
          && get(/databases/$(database)/documents/tournaments/$(tid)).data.status == 'open'
          && request.resource.data.keys().hasOnly(['json', 'name', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 30;
      }

      // Pick'Em predictions: private, like squads. Only you (and the organiser, to score them) can read yours.
      match /picks/{uid} {
        allow delete: if isAdmin();
        allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
        allow write: if request.auth != null && request.auth.uid == uid
          && get(/databases/$(database)/documents/tournaments/$(tid)).data.status == 'open'
          && request.resource.data.keys().hasOnly(['json', 'name', 'updatedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 30;
      }

      // Pick'Em leaderboard rows: signed-in players read them, only the organiser writes them.
      match /pickscores/{uid} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }

      // Leaderboard rows. Signed-in players can read them, only the organiser writes them.
      match /scores/{uid} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
      }
    }

    // Mini-leagues. The join code is the document id. Each belongs to one tournament.
    match /leagues/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && (request.auth.uid in resource.data.memberIds || isAdmin());
      allow delete: if isAdmin();   // the organiser can remove a deleted tournament's leagues
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.tournamentId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.size() <= 30;
    }
  }
}